{
	"name": "@obi1-dev/design-system",
	"version": "1.1.0",
	"description": "obi1 デザインシステム（冬空と稜線）のトークン・Tailwind テーマ・Marp テーマ・山のモチーフ",
	"type": "module",
	"private": true,
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/obi1-dev/design-system.git"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/tokens.d.ts",
			"default": "./dist/tokens.js"
		},
		"./tokens.css": "./dist/tokens.css",
		"./tailwind.css": "./dist/tailwind.css",
		"./fonts.css": "./dist/fonts.css",
		"./tokens.json": "./dist/tokens.json",
		"./marp/*": "./dist/marp/*",
		"./motifs": {
			"types": "./dist/motifs.d.ts",
			"default": "./dist/motifs.js"
		},
		"./motifs/*": "./dist/motifs/*"
	},
	"scripts": {
		"build": "node scripts/build.mjs",
		"check": "node scripts/build.mjs && git diff --exit-code -- dist"
	},
	"engines": {
		"node": ">=22"
	}
}
